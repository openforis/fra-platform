FROM node:24.15.0

WORKDIR /app

COPY package.json yarn.lock ./
# Keeps yarn's cache out of the image, private because the Playwright image installs at the same time
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn,sharing=private yarn install --frozen-lockfile

COPY . .
RUN yarn build

EXPOSE 9001
CMD ["yarn", "start"]
