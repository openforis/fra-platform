FROM node:24.15.0-slim

WORKDIR /app

COPY package.json yarn.lock ./
# Keeps yarn's cache out of the image, private because the web image installs at the same time
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn,sharing=private PUPPETEER_SKIP_DOWNLOAD=true yarn install --frozen-lockfile

RUN yarn playwright install --with-deps chromium

COPY . .

EXPOSE 9323

CMD ["yarn", "test:e2e"]
