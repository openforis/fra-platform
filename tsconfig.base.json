{
  "include": ["src"],
  "exclude": ["src/tools/migrations/steps/steps/template.ts", "src/tools/stressTestK6"],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist/",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "target": "ESNext"
  },
  "references": [
    {
      "path": "./src/test/config/tsconfig.vitest.json"
    },
    {
      "path": "./tsconfig.vite.json"
    }
  ]
}
