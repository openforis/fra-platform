  "scripts": {
    "build": "run-s build:prod:client build:prod:server build:prod:server:resources",
    "build:prod:client": "cross-env NODE_ENV=production webpack --config webpack.config.babel.js",
    "build:prod:server": "yarn tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:prod:server:resources": "shx cp -Rf web-resources dist/ && shx cp -Rf src/server/static dist/server/",
    "build:prod:report": "cross-env NODE_ENV=production BUILD_REPORT=true webpack --display-error-details -p --config webpack.config.babel.js",
    "cache:generate": "ts-node src/tools/generateCache/",
    "clean": "shx rm -rf dist/",
    "heroku-cleanup": "cd node_modules/bcrypt && node-pre-gyp install --fallback-to-build",
    "migration-steps:create": "ts-node src/tools/migrations/steps/createMigrationStep.ts",
    "migration-steps:reset": "ts-node src/tools/migrations/steps/reset.ts",
    "migration-steps:run": "ts-node src/tools/migrations/steps/",
    "migration-steps:watch": "ts-node-dev --respawn --transpile-only --exit-child --watch src/tools/migrations/steps/ src/tools/migrations/steps/ -- --watch",
    "run:dev": "run-p run:dev:client run:dev:server",
    "run:dev:client": "cross-env NODE_ENV=development webpack serve --config webpack.config.babel.js",
    "run:dev:server": "ts-node-dev --files --exit-child src/server/start",
    "run:prod": "run-s clean build start",
    "run:heroku:start": "heroku local:start",
    "run:heroku:local": "run-s clean build run:heroku:start",
    "start": "node dist/server/start",
    "//test": "mochapack --webpack-config webpack.config.babel.test.js",
    "test": "run-p test:unit test:integration",
    "test:unit": "yarn jest --no-cache --detectOpenHandles --setupFiles dotenv/config --config jest.config.unit.js",
    "test:integration": "yarn jest --no-cache --detectOpenHandles --setupFiles dotenv/config --config jest.config.integration.js src/test/integration/integration.test.ts",
    "test:e2e": "playwright test --config ./src/test/e2e/playwright.config.ts",
    "test:e2e:dev": "playwright test --config ./src/test/e2e/playwright.config.local.ts --debug --headed --ui",
    "test:e2e:docker": "docker-compose -f src/test/e2e/docker-compose.test.yml up --build --exit-code-from playwright",
    "test:watch": "yarn jest --no-cache --detectOpenHandles --watchAll --setupFiles dotenv/config --config jest.config.unit.js",
    "preversion": "git diff --quiet || { echo \"Working directory is dirty\"; exit 1; };",
    "postversion": "git push --tags && echo \"Successfully released version $npm_package_version!\"",
    "prepare": "husky install",
    "postinstall": "husky install",
    "pre-commit": "lint-staged",
    "geo:forest-estimations-import": "ts-node src/tools/geo/forestEstimationsImport.ts",
    "geo:bounds-import": "ts-node src/tools/geo/boundsImport.ts"
  },
