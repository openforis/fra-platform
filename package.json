  },
  "scripts": {
    "build": "npm-run-all --parallel build:prod:client build:prod:server --sequential build:prod:server:resources",
    "build:prod:client": "vite build",
    "build:prod:server": "yarn tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:prod:server:resources": "shx cp -Rf src/server/static dist/server/",
    "clean": "shx rm -rf dist/",
    "migration-steps:create": "ts-node src/tools/migrations/steps/createMigrationStep.ts",
    "migration-steps:reset": "ts-node src/tools/migrations/steps/reset.ts",
    "migration-steps:run": "ts-node src/tools/migrations/steps/",
    "migration-steps:watch": "ts-node-dev --respawn --transpile-only --exit-child --watch src/tools/migrations/steps/ src/tools/migrations/steps/ -- --watch",
    "run:dev": "run-p run:dev:server run:dev:client",
    "run:dev:client": "wait-on http://localhost:9001/api/health && vite --host",
    "run:dev:server": "ts-node-dev --files --exit-child --project tsconfig.server.json src/server/start",
    "run:prod": "run-s clean build start",
    "run:heroku:start": "heroku local:start",
    "run:heroku:local": "run-s clean build run:heroku:start",
    "start": "node dist/server/start",
    "test": "run-p test:unit test:integration",
    "test:unit": "vitest run --config src/test/config/vitest.unit.config.ts",
    "test:integration": "vitest run --config src/test/config/vitest.integration.config.ts",
    "test:e2e": "playwright test --config ./src/test/e2e/playwright.config.ts",
    "test:e2e:dev": "playwright test --config ./src/test/e2e/playwright.config.local.ts --debug --headed --ui",
    "test:e2e:docker": "docker-compose -f src/test/e2e/docker-compose.test.yml up --build --exit-code-from playwright",
    "preversion": "git diff --quiet || { echo \"Working directory is dirty\"; exit 1; };",
    "postversion": "git push --tags && echo \"Successfully released version $npm_package_version!\"",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
