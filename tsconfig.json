{
  "allowSyntheticDefaults": true,
  "include": ["src"],
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "isolatedModules": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist/",
    "resolveJsonModule": true,
    "target": "ESNext",
    "esModuleInterop": true
  }
}
