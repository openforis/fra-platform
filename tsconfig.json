{
  "extends": "./tsconfig.base.json",
  "allowSyntheticDefaults": true,
  "ts-node": {
    "compilerOptions": {
      "module": "Node20",
      "moduleResolution": "Node16"
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["google.maps", "vite/client", "youtube"]
  }
}
